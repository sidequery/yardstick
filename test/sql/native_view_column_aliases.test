# name: test/sql/native_view_column_aliases.test
# description: Explicit view aliases rename measure and dimension metadata together.
# group: [yardstick]

require-env YARDSTICK_NATIVE_PEG 1

require yardstick

statement ok
CREATE TABLE native_column_sales(year INTEGER, amount INTEGER);

statement ok
INSERT INTO native_column_sales VALUES (2022, 100), (2022, 50), (2023, 225);

statement ok
CREATE TABLE native_column_overlap(amount INTEGER, revenue INTEGER);

statement ok
INSERT INTO native_column_overlap VALUES (10, 1), (20, 2);

foreach parser_mode true false

statement ok
SET heap_based_parser=${parser_mode};

statement ok
CREATE OR REPLACE VIEW native_column_full(fiscal_year, total) AS
SELECT year, SUM(amount) AS MEASURE revenue FROM native_column_sales;

query IR rowsort
SELECT fiscal_year, AGGREGATE(total) FROM native_column_full;
----
2022	150.0
2023	225.0

statement ok
CREATE OR REPLACE VIEW native_column_partial(fiscal_year) AS
SELECT year, SUM(amount) AS MEASURE revenue FROM native_column_sales;

query IR rowsort
SELECT fiscal_year, AGGREGATE(revenue) FROM native_column_partial;
----
2022	150.0
2023	225.0

statement ok
CREATE OR REPLACE VIEW native_column_materialized("Fiscal year", "Distinct total") AS
SELECT year AS original_year, COUNT(DISTINCT amount) AS MEASURE original_total
FROM native_column_sales GROUP BY original_year;

query II rowsort
SELECT "Fiscal year", AGGREGATE("Distinct total") FROM native_column_materialized;
----
2022	2
2023	1

query I
SELECT AGGREGATE("Distinct total") FROM native_column_materialized;
----
3

statement ok
CREATE OR REPLACE VIEW native_column_count(fiscal_year, total_rows) AS
SELECT year, COUNT(*) AS MEASURE row_count FROM native_column_sales;

query II rowsort
SELECT fiscal_year, AGGREGATE(total_rows) FROM native_column_count;
----
2022	2
2023	1

statement ok
CREATE OR REPLACE VIEW native_column_partial_group(fiscal_year) AS
SELECT year AS original_year, COUNT(DISTINCT amount) AS MEASURE revenue
FROM native_column_sales GROUP BY original_year;

query II rowsort
SELECT fiscal_year, AGGREGATE(revenue) FROM native_column_partial_group;
----
2022	2
2023	1

statement ok
CREATE OR REPLACE VIEW native_column_expression(next_year, total) AS
SELECT year + 1 AS original_year, SUM(amount) AS MEASURE revenue
FROM native_column_sales;

query R
SELECT AGGREGATE(total) AT (SET next_year = 2023) FROM native_column_expression;
----
150.0

statement ok
CREATE OR REPLACE VIEW native_column_derived(total, doubled, base_total, rounded) AS
SELECT SUM(amount) AS MEASURE revenue,
       revenue * 2 AS MEASURE twice,
       SUM(revenue) AS MEASURE base_revenue,
       ROUND(revenue * 2) AS MEASURE rounded_revenue
FROM native_column_overlap;

query RRRR
SELECT AGGREGATE(total), AGGREGATE(doubled), AGGREGATE(base_total), AGGREGATE(rounded)
FROM native_column_derived;
----
30.0	60.0	3.0	60.0

statement ok
CREATE OR REPLACE VIEW native_column_quoted_derived("Total revenue", "Double revenue") AS
SELECT SUM(amount) AS MEASURE "gross revenue",
       "gross revenue" * 2 AS MEASURE "double gross"
FROM native_column_overlap;

query RR
SELECT AGGREGATE("Total revenue"), AGGREGATE("Double revenue") FROM native_column_quoted_derived;
----
30.0	60.0

statement ok
CREATE OR REPLACE VIEW native_column_full(fiscal_year, total) AS
SELECT year, SUM(amount * 10) AS MEASURE revenue FROM native_column_sales;

query IR rowsort
SELECT fiscal_year, AGGREGATE(total) FROM native_column_full;
----
2022	1500.0
2023	2250.0

statement ok
SET allow_parser_override_extension='strict';

statement error
CREATE VIEW native_column_cycle(total, other) AS
SELECT second_measure + 1 AS MEASURE first_measure,
       first_measure + 1 AS MEASURE second_measure
FROM native_column_sales;
----
Cyclic AS MEASURE declaration reference

statement error
CREATE OR REPLACE VIEW native_column_full(a, b, c) AS
SELECT year, SUM(amount) AS MEASURE revenue FROM native_column_sales;
----
More VIEW aliases than columns in query result

query IR rowsort
SELECT fiscal_year, AGGREGATE(total) FROM native_column_full;
----
2022	1500.0
2023	2250.0

statement ok
CREATE OR REPLACE VIEW native_column_star(fiscal_year, value, total) AS
SELECT *, SUM(amount) AS MEASURE revenue FROM native_column_sales;

query R
SELECT AGGREGATE(total) FROM native_column_star;
----
375.0

statement ok
CREATE OR REPLACE VIEW native_column_ordinary(fiscal_year, total) AS
SELECT year, amount AS measure FROM native_column_sales;

query II
SELECT fiscal_year, total FROM native_column_ordinary ORDER BY fiscal_year, total;
----
2022	50
2022	100
2023	225

statement ok
SET allow_parser_override_extension='fallback';

endloop
