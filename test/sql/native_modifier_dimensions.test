# name: test/sql/native_modifier_dimensions.test
# description: Native modifier dimensions match canonical expression rendering.
# group: [yardstick]

require-env YARDSTICK_NATIVE_PEG 1

require yardstick

statement ok
CREATE TABLE modifier_dates (day DATE, label VARCHAR, amount INTEGER);

statement ok
INSERT INTO modifier_dates VALUES ('2023-01-01', 'US', 10), ('2023-02-01', 'us', 20);

statement ok
CREATE VIEW modifier_dates_v AS SELECT day, label, SUM(amount) AS MEASURE modifier_revenue FROM modifier_dates;

query IR rowsort
SELECT MONTH(DAY), "AGGREGATE"(modifier_revenue) AT (SET month(day) = 2) FROM modifier_dates_v;
----
1	20.0
2	20.0

query IR rowsort
SELECT CASE WHEN label = 'US' THEN 1 ELSE 2 END, "AGGREGATE"(modifier_revenue) AT (ALL CASE WHEN LABEL = 'US' THEN 1 ELSE 2 END) FROM modifier_dates_v;
----
1	30.0
2	30.0

# String literals remain case-sensitive when deciding which dimension ALL removes.
query IR rowsort
SELECT CASE WHEN label = 'US' THEN 1 ELSE 2 END, "AGGREGATE"(modifier_revenue) AT (ALL CASE WHEN label = 'us' THEN 1 ELSE 2 END) FROM modifier_dates_v;
----
1	10.0
2	20.0

query IR rowsort
SELECT MONTH(day), "AGGREGATE"(modifier_revenue) AT (SET MONTH(day) = 2) FROM modifier_dates_v;
----
1	20.0
2	20.0

query IR rowsort
SELECT MONTH(day), "AGGREGATE"(modifier_revenue) AT (ALL MONTH(day)) FROM modifier_dates_v;
----
1	30.0
2	30.0

query IR rowsort
SELECT MONTH(day), "AGGREGATE"(modifier_revenue) AT (VISIBLE SET MONTH(day) = 2) FROM modifier_dates_v;
----
1	20.0
2	20.0

query IR rowsort
SELECT MONTH(day), "AGGREGATE"(modifier_revenue) AT (ALL "month"(day) SET MONTH(day) = 2) FROM modifier_dates_v;
----
1	20.0
2	20.0

query IR rowsort
SELECT MONTH(day), "AGGREGATE"(modifier_revenue) AT (SET MONTH(day) = 2 ALL "month"(day)) FROM modifier_dates_v;
----
1	30.0
2	30.0


statement ok
DROP VIEW modifier_dates_v;

statement ok
DROP TABLE modifier_dates;

# These run in the caller's session, so sequence state shows how often each
# volatile call was evaluated.
# Repeated volatile calls are distinct evaluations, even when their parsed
# expressions are identical. Disable optimizer rewrites to test Yardstick alone.
statement ok
PRAGMA disable_optimizer;

statement ok
CREATE TABLE volatile_review_sales(y INTEGER,r VARCHAR,a INTEGER);

statement ok
INSERT INTO volatile_review_sales VALUES (2024,'N',40),(2024,'S',80);

statement ok
CREATE VIEW volatile_review_v AS SELECT y,r,SUM(a) AS MEASURE volatile_review_m FROM volatile_review_sales;

statement ok
CREATE SEQUENCE volatile_review_expected START 1;

statement ok
CREATE SEQUENCE volatile_review_actual START 1;

query I
SELECT SUM(a) FROM volatile_review_sales
WHERE y=2024 AND (nextval('volatile_review_expected')%3=0 OR nextval('volatile_review_expected')%3=0);
----
40

query I
SELECT AGGREGATE(volatile_review_m) AT (
    WHERE y=2023 AND (nextval('volatile_review_actual')%3=0 OR nextval('volatile_review_actual')%3=0)
    SET y=2024
) FROM volatile_review_v;
----
40

query II
SELECT currval('volatile_review_expected'),currval('volatile_review_actual');
----
4	4

statement error
SELECT * FROM yardstick($$SELECT AGGREGATE(volatile_review_m) AT (
    WHERE (y=2023 AND nextval('volatile_review_actual')%3=0)
       OR (y=2025 AND nextval('volatile_review_actual')%3=0)
    SET y=2024
) FROM volatile_review_v$$);
----
cannot safely normalize

query I
SELECT currval('volatile_review_actual');
----
4

statement ok
PRAGMA enable_optimizer;
